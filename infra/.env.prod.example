# Cấu hình production — KHÔNG commit file .env.prod thật (chỉ commit bản mẫu này)
# Tạo bản thật: cp infra/.env.prod.example infra/.env.prod && nano infra/.env.prod

# BẮT BUỘC: chuỗi ngẫu nhiên dài, ví dụ: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=change-me-to-a-long-random-string

DEMO_MODE=true
# Chỉ bật lần đầu cho demo — seed XÓA dữ liệu cũ
SEED_ON_START=0

POSTGRES_USER=allercare
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=allercare

ALLOWED_ORIGINS=http://localhost:3000

# AI (tùy chọn — để demo thì bỏ trống)
AI_PROVIDER=demo
AI_API_KEY=
VIDEO_BASE_URL=

# Port public trên host (đổi nếu 8000/3000 đã bận)
API_PORT=8000
WEB_PORT=3000
